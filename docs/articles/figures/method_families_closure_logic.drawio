<mxfile host="app.diagrams.net" agent="ChatGPT">
  <diagram id="method_families_closure_logic" name="Method families closure logic">
    <mxGraphModel dx="2009" dy="2331" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr_pt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#2f5da8;fontColor=#2f5da8;" value="Priestley–Taylor" vertex="1">
          <mxGeometry height="54" width="288" x="115" y="94" as="geometry" />
        </mxCell>
        <mxCell id="hdr_bulk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;spacing=6;fillColor=#fff2cc;strokeColor=#d79b00;fontColor=#d79b00;" value="Bulk–Residual" vertex="1">
          <mxGeometry height="54" width="288" x="419" y="94" as="geometry" />
        </mxCell>
        <mxCell id="hdr_bowen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;spacing=6;fillColor=#e2f0d9;strokeColor=#6aa84f;fontColor=#6aa84f;" value="Bowen" vertex="1">
          <mxGeometry height="54" width="288" x="723" y="94" as="geometry" />
        </mxCell>
        <mxCell id="hdr_monin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;spacing=6;fillColor=#eadcf8;strokeColor=#674ea7;fontColor=#674ea7;" value="Monin–Obukhov / Profile" vertex="1">
          <mxGeometry height="54" width="288" x="1027" y="94" as="geometry" />
        </mxCell>
        <mxCell id="hdr_penman" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;spacing=6;fillColor=#fce5cd;strokeColor=#b45f06;fontColor=#b45f06;" value="Penman (latent only)" vertex="1">
          <mxGeometry height="54" width="288" x="1331" y="94" as="geometry" />
        </mxCell>
        <mxCell id="row_flux" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fillColor=#f7f7f7;strokeColor=#b7b7b7;" value="1. Flux&lt;br&gt;estimation&lt;br&gt;logic" vertex="1">
          <mxGeometry height="236" width="89" x="11" y="174" as="geometry" />
        </mxCell>
        <mxCell id="row_closure" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fillColor=#f7f7f7;strokeColor=#b7b7b7;" value="2. Closure&lt;br&gt;logic" vertex="1">
          <mxGeometry height="193" width="89" x="11" y="429" as="geometry" />
        </mxCell>
        <mxCell id="row_procon" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fillColor=#f7f7f7;strokeColor=#b7b7b7;" value="&lt;div style=&quot;line-height: 290%;&quot;&gt;&lt;font color=&quot;#1b5e20&quot;&gt;Main pro&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#990000&quot;&gt;Main con&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="89" x="11" y="649" as="geometry" />
        </mxCell>
        <mxCell id="flux_pt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=16;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#2f5da8;" value="&lt;b&gt;Empirical partition&lt;/b&gt;&lt;br&gt;&lt;br&gt;Latent heat from available energy via the Priestley–Taylor coefficient α&lt;sub&gt;PT&lt;/sub&gt;.&lt;br&gt;&lt;br&gt;Sensible heat is the complement." vertex="1">
          <mxGeometry height="231" width="288" x="115" y="174" as="geometry" />
        </mxCell>
        <mxCell id="closure_pt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=16;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#2f5da8;" value="&lt;b&gt;Partition closure&lt;/b&gt;&lt;br&gt;&lt;br&gt;LE&lt;sub&gt;PT&lt;/sub&gt; = α&lt;sub&gt;PT&lt;/sub&gt; · f(R&lt;sub&gt;n&lt;/sub&gt; − G)&lt;br&gt;H&lt;sub&gt;PT&lt;/sub&gt; = (R&lt;sub&gt;n&lt;/sub&gt; − G) − LE&lt;sub&gt;PT&lt;/sub&gt;&lt;br&gt;&lt;br&gt;Balance closes by construction:&lt;br&gt;&lt;b&gt;R&lt;sub&gt;E&lt;/sub&gt; ≈ 0&lt;/b&gt;." vertex="1">
          <mxGeometry height="193" width="288" x="115" y="429" as="geometry" />
        </mxCell>
        <mxCell id="procon_pt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=16;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#2f5da8;" value="&lt;div&gt;&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;+&lt;/b&gt; Simple, robust, needs few inputs.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#990000&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;font color=&quot;#990000&quot;&gt;&lt;b&gt;−&lt;/b&gt; Empirical; α&lt;sub&gt;PT&lt;/sub&gt; needs calibration and is weak under strong advection.&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="170" width="288" x="115" y="649" as="geometry" />
        </mxCell>
        <mxCell id="flux_bulk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=16;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d79b00;" value="&lt;b&gt;Bulk exchange estimate for sensible heat&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;H&lt;sub&gt;bulk&lt;/sub&gt;&lt;/b&gt; from temperature gradient and an exchange-velocity scale &lt;b&gt;u&lt;sub&gt;scale&lt;/sub&gt;&lt;/b&gt;.&lt;br&gt;&lt;br&gt;&lt;b&gt;Exchange-velocity options:&lt;/b&gt;&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;wind_mean&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;u_star_profile&lt;/font&gt;&lt;br&gt;• &lt;font face=&quot;Courier New&quot;&gt;u_star_roughness&lt;/font&gt;" vertex="1">
          <mxGeometry height="231" width="288" x="419" y="174" as="geometry" />
        </mxCell>
        <mxCell id="closure_bulk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=13;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d79b00;" value="&lt;b&gt;Residual closure for latent heat&lt;/b&gt;&lt;br&gt;&lt;br&gt;LE&lt;sub&gt;res&lt;/sub&gt; = R&lt;sub&gt;n&lt;/sub&gt; − G − H&lt;sub&gt;bulk&lt;/sub&gt;&lt;br&gt;&lt;br&gt;(&lt;font face=&quot;Courier New&quot;&gt;latent_bulk_residual&lt;/font&gt;)&lt;br&gt;&lt;br&gt;Balance closes by construction:&lt;br&gt;&lt;b&gt;R&lt;sub&gt;E&lt;/sub&gt; ≈ 0&lt;/b&gt;." vertex="1">
          <mxGeometry height="193" width="288" x="419" y="429" as="geometry" />
        </mxCell>
        <mxCell id="procon_bulk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=16;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d79b00;" value="&lt;div&gt;&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;+&lt;/b&gt; Flexible sensible-heat estimate: simple → profile-like.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#990000&quot;&gt;&lt;b&gt;−&lt;/b&gt; Latent heat is residual; errors in R&lt;sub&gt;n&lt;/sub&gt;, G and H&lt;sub&gt;bulk&lt;/sub&gt; are inherited by LE&lt;sub&gt;res&lt;/sub&gt;.&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="288" x="419" y="649" as="geometry" />
        </mxCell>
        <mxCell id="flux_bowen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=16;align=left;verticalAlign=top;spacing=10;fillColor=#e2f0d9;strokeColor=#6aa84f;" value="&lt;b&gt;Gradient-ratio estimate&lt;/b&gt;&lt;br&gt;&lt;br&gt;Latent and sensible heat from temperature and moisture gradients via Bowen ratio β, with stability corrections." vertex="1">
          <mxGeometry height="231" width="288" x="723" y="174" as="geometry" />
        </mxCell>
        <mxCell id="closure_bowen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=16;align=left;verticalAlign=top;spacing=10;fillColor=#e2f0d9;strokeColor=#6aa84f;" value="&lt;b&gt;Partition closure&lt;/b&gt;&lt;br&gt;&lt;br&gt;H = β / (1 + β) · (R&lt;sub&gt;n&lt;/sub&gt; − G)&lt;br&gt;LE = 1 / (1 + β) · (R&lt;sub&gt;n&lt;/sub&gt; − G)&lt;br&gt;&lt;br&gt;If β is finite and valid, balance closes:&lt;br&gt;&lt;b&gt;R&lt;sub&gt;E&lt;/sub&gt; ≈ 0&lt;/b&gt;." vertex="1">
          <mxGeometry height="193" width="288" x="723" y="429" as="geometry" />
        </mxCell>
        <mxCell id="procon_bowen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=16;align=left;verticalAlign=top;spacing=10;fillColor=#e2f0d9;strokeColor=#6aa84f;" value="&lt;div&gt;&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;+&lt;/b&gt; Uses both temperature and humidity gradients.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#990000&quot;&gt;&lt;b&gt;−&lt;/b&gt; Unstable if gradients are small; requires capping and filters.&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="288" x="723" y="649" as="geometry" />
        </mxCell>
        <mxCell id="flux_monin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=16;align=left;verticalAlign=top;spacing=10;fillColor=#eadcf8;strokeColor=#674ea7;" value="&lt;b&gt;Profile / stability-based&lt;/b&gt;&lt;br&gt;&lt;br&gt;Latent and sensible heat from vertical gradients and stability correction functions.&lt;br&gt;&lt;br&gt;No a priori normalization to available energy." vertex="1">
          <mxGeometry height="221" width="288" x="1027" y="174" as="geometry" />
        </mxCell>
        <mxCell id="closure_monin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=16;align=left;verticalAlign=top;spacing=10;fillColor=#eadcf8;strokeColor=#674ea7;" value="&lt;b&gt;No forced closure&lt;/b&gt;&lt;br&gt;&lt;br&gt;R&lt;sub&gt;M&lt;/sub&gt; = R&lt;sub&gt;n&lt;/sub&gt; − G − H&lt;sub&gt;MO&lt;/sub&gt; − LE&lt;sub&gt;MO&lt;/sub&gt;&lt;br&gt;&lt;br&gt;(diagnostic residual)&lt;br&gt;&lt;br&gt;Left open and interpreted as diagnostic residual." vertex="1">
          <mxGeometry height="193" width="288" x="1027" y="429" as="geometry" />
        </mxCell>
        <mxCell id="procon_monin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=16;align=left;verticalAlign=top;spacing=10;fillColor=#eadcf8;strokeColor=#674ea7;" value="&lt;div&gt;&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;+&lt;/b&gt; Physically rich with stability; no a priori normalization.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#990000&quot;&gt;&lt;b&gt;−&lt;/b&gt; Needs good profiles; may leave non-zero residual.&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="288" x="1027" y="649" as="geometry" />
        </mxCell>
        <mxCell id="flux_penman" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=16;align=left;verticalAlign=top;spacing=10;fillColor=#fce5cd;strokeColor=#b45f06;" value="&lt;b&gt;Aerodynamic–energy approach for latent heat&lt;/b&gt;&lt;br&gt;&lt;br&gt;Latent heat estimated from available energy and an aerodynamic drying-power term.&lt;br&gt;&lt;br&gt;No sensible heat is calculated." vertex="1">
          <mxGeometry height="221" width="288" x="1331" y="174" as="geometry" />
        </mxCell>
        <mxCell id="closure_penman" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=16;align=left;verticalAlign=top;spacing=10;fillColor=#fce5cd;strokeColor=#b45f06;" value="&lt;b&gt;No paired closure&lt;/b&gt;&lt;br&gt;&lt;br&gt;Open complement after subtracting latent heat:&lt;br&gt;&lt;br&gt;U&lt;sub&gt;Penman&lt;/sub&gt; = R&lt;sub&gt;n&lt;/sub&gt; − G − LE&lt;sub&gt;Penman&lt;/sub&gt;&lt;br&gt;&lt;br&gt;Not automatically sensible heat." vertex="1">
          <mxGeometry height="193" width="288" x="1331" y="429" as="geometry" />
        </mxCell>
        <mxCell id="procon_penman" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=16;align=left;verticalAlign=top;spacing=10;fillColor=#fce5cd;strokeColor=#b45f06;" value="&lt;div&gt;&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;+&lt;/b&gt; Works with limited inputs; latent-heat estimation.&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#990000&quot;&gt;&lt;b&gt;−&lt;/b&gt; No sensible heat; open complement is not H.&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="288" x="1332" y="649" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=15;align=left;verticalAlign=top;spacing=12;fillColor=#f8f9fa;strokeColor=#b7b7b7;" value="&lt;b style=&quot;white-space: nowrap;&quot;&gt;R&lt;sub&gt;n&lt;/sub&gt;&lt;/b&gt;&lt;span style=&quot;white-space: nowrap;&quot;&gt;: net radiation (W m&lt;/span&gt;&lt;sup style=&quot;white-space: nowrap;&quot;&gt;−2&lt;/sup&gt;&lt;span style=&quot;white-space: nowrap;&quot;&gt;) &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;white-space: nowrap;&quot;&gt;G&lt;/b&gt;&lt;span style=&quot;white-space: nowrap;&quot;&gt;: soil heat flux (W m&lt;/span&gt;&lt;sup style=&quot;white-space: nowrap;&quot;&gt;−2&lt;/sup&gt;&lt;span style=&quot;white-space: nowrap;&quot;&gt;) &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;white-space: nowrap;&quot;&gt;H&lt;/b&gt;&lt;span style=&quot;white-space: nowrap;&quot;&gt;: sensible heat flux (W m&lt;/span&gt;&lt;sup style=&quot;white-space: nowrap;&quot;&gt;−2&lt;/sup&gt;&lt;span style=&quot;white-space: nowrap;&quot;&gt;) &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;white-space: nowrap;&quot;&gt;LE&lt;/b&gt;&lt;span style=&quot;white-space: nowrap;&quot;&gt;: latent heat flux (W m&lt;/span&gt;&lt;sup style=&quot;white-space: nowrap;&quot;&gt;−2&lt;/sup&gt;&lt;span style=&quot;white-space: nowrap;&quot;&gt;) &amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;white-space: nowrap;&quot;&gt;R&lt;sub&gt;E&lt;/sub&gt;&lt;/b&gt;&lt;span style=&quot;white-space: nowrap;&quot;&gt; = R&lt;/span&gt;&lt;sub style=&quot;white-space: nowrap;&quot;&gt;n&lt;/sub&gt;&lt;span style=&quot;white-space: nowrap;&quot;&gt; − G − H − LE&lt;/span&gt;&lt;b&gt;&lt;br&gt;&lt;br&gt;Bulk–Residual combines two levels.&lt;/b&gt; First, H&lt;sub&gt;bulk&lt;/sub&gt; is estimated using a temperature gradient and an exchange-velocity scale. This scale may be a simple mean-wind approximation (&lt;font face=&quot;Courier New&quot;&gt;wind_mean&lt;/font&gt;), a profile-derived friction velocity from two wind heights (&lt;font face=&quot;Courier New&quot;&gt;u_star_profile&lt;/font&gt;), or a roughness-based friction velocity (&lt;font face=&quot;Courier New&quot;&gt;u_star_roughness&lt;/font&gt;). This makes the sensible-heat estimate more or less close to a neutral profile-transfer logic. Second, latent heat is calculated as the residual of the available energy: &lt;b&gt;LE&lt;sub&gt;res&lt;/sub&gt; = R&lt;sub&gt;n&lt;/sub&gt; − G − H&lt;sub&gt;bulk&lt;/sub&gt;&lt;/b&gt;. A near-zero closure residual therefore confirms the algebraic residual construction. It does not prove that the selected exchange-velocity assumption is physically correct.&lt;br&gt;&lt;br&gt;&lt;b&gt;Monin–Obukhov / Profile&lt;/b&gt; does not normalize fluxes to available energy. The residual &lt;b&gt;R&lt;sub&gt;M&lt;/sub&gt;&lt;/b&gt; is diagnostic and must not be forced to zero.&lt;br&gt;&lt;br&gt;&lt;b&gt;Penman&lt;/b&gt; provides only latent heat. The open complement &lt;b&gt;U&lt;sub&gt;Penman&lt;/sub&gt;&lt;/b&gt; is not automatically sensible heat." vertex="1">
          <mxGeometry height="236" width="1505" x="115" y="833" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
