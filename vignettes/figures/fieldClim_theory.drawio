  <diagram id="method_families_closure_logic" name="Method families closure logic">
    <mxGraphModel dx="1884" dy="2082" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hdr_pt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontStyle=1;fontSize=24;align=center;verticalAlign=middle;spacing=6;fillColor=#dae8fc;strokeColor=#2f5da8;fontColor=#2f5da8;" value="Priestley–Taylor" vertex="1">
          <mxGeometry height="54" width="288" x="115" y="94" as="geometry" />
