        <mxCell id="hdr_bulk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontStyle=1;fontSize=24;align=center;verticalAlign=middle;spacing=6;fillColor=#fff2cc;strokeColor=#d79b00;fontColor=#d79b00;" value="Bulk–Residual" vertex="1">
          <mxGeometry height="54" width="288" x="419" y="94" as="geometry" />
        </mxCell>
        <mxCell id="hdr_bowen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontStyle=1;fontSize=24;align=center;verticalAlign=middle;spacing=6;fillColor=#e2f0d9;strokeColor=#6aa84f;fontColor=#6aa84f;" value="Bowen" vertex="1">
          <mxGeometry height="54" width="288" x="723" y="94" as="geometry" />
        </mxCell>
        <mxCell id="hdr_monin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontStyle=1;fontSize=24;align=center;verticalAlign=middle;spacing=6;fillColor=#eadcf8;strokeColor=#674ea7;fontColor=#674ea7;" value="Monin–Obukhov / Profile" vertex="1">
          <mxGeometry height="54" width="303" x="1027" y="94" as="geometry" />
        </mxCell>
        <mxCell id="hdr_penman" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontStyle=1;fontSize=24;align=center;verticalAlign=middle;spacing=6;fillColor=#fce5cd;strokeColor=#b45f06;fontColor=#b45f06;" value="Penman (latent only)" vertex="1">
          <mxGeometry height="54" width="288" x="1344" y="94" as="geometry" />
        </mxCell>
        <mxCell id="row_flux" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fillColor=#f7f7f7;strokeColor=#b7b7b7;" value="&lt;font&gt;Flux method&lt;/font&gt;" vertex="1">
          <mxGeometry height="300" width="89" x="11" y="90" as="geometry" />
        </mxCell>
        <mxCell id="row_closure" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fillColor=#f7f7f7;strokeColor=#b7b7b7;" value="Closure regime" vertex="1">
          <mxGeometry height="184" width="89" x="11" y="415" as="geometry" />
        </mxCell>
        <mxCell id="row_procon" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=19;fontStyle=1;align=center;verticalAlign=middle;spacing=6;fillColor=#f7f7f7;strokeColor=#b7b7b7;" value="&lt;div class=&quot;flex max-w-full flex-col gap-4 grow&quot; style=&quot;font-weight: 400; text-align: start;&quot;&gt;&lt;div data-message-author-role=&quot;assistant&quot; data-message-id=&quot;2471e600-9fb7-4453-ad47-60abc2e274e3&quot; dir=&quot;auto&quot; data-message-model-slug=&quot;gpt-5-5-thinking&quot; class=&quot;min-h-8 text-message relative flex w-full flex-col items-end gap-2 text-start break-words whitespace-normal outline-none keyboard-focused:focus-ring [.text-message+&amp;amp;]:mt-1&quot; data-turn-start-message=&quot;true&quot; tabindex=&quot;0&quot;&gt;&lt;div class=&quot;flex w-full flex-col gap-1 empty:hidden&quot;&gt;&lt;div class=&quot;markdown prose dark:prose-invert wrap-break-word w-full dark markdown-new-styling&quot;&gt;&lt;p data-start=&quot;0&quot; data-end=&quot;17&quot; data-is-last-node=&quot;&quot; data-is-only-node=&quot;&quot;&gt;&lt;strong data-start=&quot;0&quot; data-end=&quot;17&quot; data-is-last-node=&quot;&quot; data-is-only-node=&quot;&quot;&gt;Usage&lt;/strong&gt;&lt;/p&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div class=&quot;z-0 flex min-h-[46px] justify-start&quot; style=&quot;font-weight: 400; text-align: start;&quot;&gt;&lt;/div&gt;&lt;div class=&quot;mt-3 w-full empty:hidden&quot; style=&quot;font-weight: 400; text-align: start;&quot;&gt;&lt;div class=&quot;text-center&quot;&gt;&lt;div class=&quot;mx-auto&quot;&gt;&lt;div class=&quot;inline-flex rounded-xl border border-gray-100 dark:border-gray-700&quot;&gt;&lt;div class=&quot;me-12 flex items-center px-4 py-3 text-start&quot;&gt;&lt;svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;20&quot; height=&quot;20&quot; aria-hidden=&quot;true&quot; class=&quot;icon-lg text-token-main-surface-primary-inverse&quot;&gt;&lt;/svg&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="199" width="89" x="11" y="620" as="geometry" />
        </mxCell>
        <mxCell id="flux_pt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#2f5da8;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;LE&lt;sub&gt;PT&lt;/sub&gt; = α&lt;sub&gt;PT&lt;/sub&gt; · Δ/(Δ + γ) · (Q* − B)&lt;br&gt;H&lt;sub&gt;PT&lt;/sub&gt; = (Q* − B) − LE&lt;sub&gt;PT&lt;/sub&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;Empirical partition of available energy A = Q* − B.&lt;/div&gt;" vertex="1">
          <mxGeometry height="216" width="288" x="115" y="174" as="geometry" />
        </mxCell>
        <mxCell id="closure_pt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#2f5da8;" value="&lt;b&gt;Partition closure&lt;/b&gt;&lt;br&gt;&lt;br&gt;Q* − B = H&lt;sub&gt;PT&lt;/sub&gt; + LE&lt;sub&gt;PT&lt;/sub&gt;&lt;br&gt;R&lt;sub&gt;E&lt;/sub&gt; = Q* − B − H&lt;sub&gt;PT&lt;/sub&gt; − LE&lt;sub&gt;PT&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;R&lt;sub&gt;E&lt;/sub&gt; ≈ 0 by assumption&lt;/b&gt;." vertex="1">
          <mxGeometry height="184" width="288" x="115" y="415" as="geometry" />
        </mxCell>
        <mxCell id="procon_pt" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#dae8fc;strokeColor=#2f5da8;" value="&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;Use:&lt;/b&gt;&lt;/font&gt; moist vegetated surfaces; robust first estimate; teaching energy partitioning.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#990000&quot;&gt;&lt;b&gt;Limitations:&lt;/b&gt;&lt;/font&gt; dry or strongly advective situations; empirical α&lt;sub&gt;PT&lt;/sub&gt; sensitivity." vertex="1">
          <mxGeometry height="199" width="288" x="115" y="620" as="geometry" />
        </mxCell>
        <mxCell id="flux_bulk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d79b00;" value="&lt;br&gt;H&lt;sub&gt;bulk&lt;/sub&gt; = ρ c&lt;sub&gt;p&lt;/sub&gt; · ΔT / r&lt;sub&gt;a&lt;/sub&gt;&lt;br&gt;LE&lt;sub&gt;res&lt;/sub&gt; = Q* − B − H&lt;sub&gt;bulk&lt;/sub&gt;&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Sensible heat from a two-level exchange estimate; latent heat as residual.&lt;/span&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="216" width="288" x="419" y="174" as="geometry" />
        </mxCell>
        <mxCell id="closure_bulk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d79b00;" value="&lt;b&gt;Residual closure&lt;/b&gt;&lt;br&gt;&lt;br&gt;LE&lt;sub&gt;res&lt;/sub&gt; = Q* − B − H&lt;sub&gt;bulk&lt;/sub&gt;&lt;br&gt;R&lt;sub&gt;E&lt;/sub&gt; = Q* − B − H&lt;sub&gt;bulk&lt;/sub&gt; − LE&lt;sub&gt;res&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;R&lt;sub&gt;E&lt;/sub&gt; = 0 by definition&lt;/b&gt;." vertex="1">
          <mxGeometry height="184" width="288" x="419" y="415" as="geometry" />
        </mxCell>
        <mxCell id="procon_bulk" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#fff2cc;strokeColor=#d79b00;" value="&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;Use:&lt;/b&gt;&lt;/font&gt; neutral bulk-transfer H estimate from standard two-level station data.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#990000&quot;&gt;&lt;b&gt;Limitations:&lt;/b&gt;&lt;/font&gt; not MOST; LE&lt;sub&gt;res&lt;/sub&gt; absorbs errors from Q*, B and H&lt;sub&gt;bulk&lt;/sub&gt;." vertex="1">
          <mxGeometry height="199" width="288" x="419" y="620" as="geometry" />
        </mxCell>
        <mxCell id="flux_bowen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#e2f0d9;strokeColor=#6aa84f;" value="&lt;br&gt;β = gradient ratio&lt;br&gt;H&lt;sub&gt;BR&lt;/sub&gt; = β/(1 + β) · (Q* − B)&lt;br&gt;LE&lt;sub&gt;BR&lt;/sub&gt; = 1/(1 + β) · (Q* − B)&lt;br&gt;&lt;br&gt;Partition of available energy by temperature and humidity gradients." vertex="1">
          <mxGeometry height="216" width="288" x="723" y="174" as="geometry" />
        </mxCell>
        <mxCell id="closure_bowen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#e2f0d9;strokeColor=#6aa84f;" value="&lt;b&gt;Partition closure&lt;/b&gt;&lt;br&gt;&lt;br&gt;Q* − B = H&lt;sub&gt;BR&lt;/sub&gt; + LE&lt;sub&gt;BR&lt;/sub&gt;&lt;br&gt;R&lt;sub&gt;E&lt;/sub&gt; = Q* − B − H&lt;sub&gt;BR&lt;/sub&gt; − LE&lt;sub&gt;BR&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;R&lt;sub&gt;E&lt;/sub&gt; ≈ 0 only for valid finite β&lt;/b&gt;." vertex="1">
          <mxGeometry height="184" width="288" x="723" y="415" as="geometry" />
        </mxCell>
        <mxCell id="procon_bowen" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#e2f0d9;strokeColor=#6aa84f;" value="&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;Use:&lt;/b&gt;&lt;/font&gt; reliable T and humidity gradients; direct H / LE partition.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#990000&quot;&gt;&lt;b&gt;Limitations:&lt;/b&gt;&lt;/font&gt; weak or noisy moisture gradients; unstable denominator cases." vertex="1">
          <mxGeometry height="199" width="288" x="723" y="620" as="geometry" />
        </mxCell>
        <mxCell id="flux_monin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#eadcf8;strokeColor=#674ea7;" value="&lt;br&gt;H&lt;sub&gt;MO&lt;/sub&gt;, LE&lt;sub&gt;MO&lt;/sub&gt; = f(profile, z&lt;sub&gt;0&lt;/sub&gt;, stability)&lt;br&gt;R&lt;sub&gt;E,MO&lt;/sub&gt; = Q* − B − H&lt;sub&gt;MO&lt;/sub&gt; − LE&lt;sub&gt;MO&lt;/sub&gt;&lt;br&gt;&lt;br&gt;&lt;br&gt;Profile- and stability-based flux diagnosis, not normalized to A." vertex="1">
          <mxGeometry height="216" width="303" x="1027" y="174" as="geometry" />
        </mxCell>
        <mxCell id="closure_monin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#eadcf8;strokeColor=#674ea7;" value="&lt;b&gt;Diagnostic residual&lt;/b&gt;&lt;br&gt;&lt;br&gt;R&lt;sub&gt;E,MO&lt;/sub&gt; = Q* − B − H&lt;sub&gt;MO&lt;/sub&gt; − LE&lt;sub&gt;MO&lt;/sub&gt;&lt;br&gt;&lt;br&gt;No forced closure.&lt;br&gt;&lt;b&gt;R&lt;sub&gt;E,MO&lt;/sub&gt; remains visible&lt;/b&gt;." vertex="1">
          <mxGeometry height="184" width="303" x="1027" y="415" as="geometry" />
        </mxCell>
        <mxCell id="procon_monin" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#eadcf8;strokeColor=#674ea7;" value="&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;Use:&lt;/b&gt;&lt;/font&gt; profile- and stability-based process diagnosis.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#990000&quot;&gt;&lt;b&gt;Limitations:&lt;/b&gt;&lt;/font&gt; input- and parameter-intensive; not energy-balance closing." vertex="1">
          <mxGeometry height="199" width="303" x="1027" y="620" as="geometry" />
        </mxCell>
        <mxCell id="flux_penman" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#fce5cd;strokeColor=#b45f06;" value="&lt;br&gt;LE&lt;sub&gt;Penman&lt;/sub&gt; = Δ/(Δ + γ) · (Q* − B) + γ/(Δ + γ) · E&lt;sub&gt;a&lt;/sub&gt;&lt;br&gt;U&lt;sub&gt;Penman&lt;/sub&gt; = Q* − B − LE&lt;sub&gt;Penman&lt;/sub&gt;&lt;br&gt;&lt;br&gt;Latent-heat estimate plus open complement." vertex="1">
          <mxGeometry height="216" width="288" x="1344" y="174" as="geometry" />
        </mxCell>
        <mxCell id="closure_penman" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#fce5cd;strokeColor=#b45f06;" value="&lt;b&gt;LE-only / open complement&lt;/b&gt;&lt;br&gt;&lt;br&gt;U&lt;sub&gt;Penman&lt;/sub&gt; = Q* − B − LE&lt;sub&gt;Penman&lt;/sub&gt;&lt;br&gt;&lt;br&gt;No paired H is calculated.&lt;br&gt;&lt;b&gt;U&lt;sub&gt;Penman&lt;/sub&gt; is not H&lt;/b&gt;." vertex="1">
          <mxGeometry height="184" width="288" x="1344" y="415" as="geometry" />
        </mxCell>
        <mxCell id="procon_penman" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=10;fillColor=#fce5cd;strokeColor=#b45f06;" value="&lt;font color=&quot;#1b5e20&quot;&gt;&lt;b&gt;Use:&lt;/b&gt;&lt;/font&gt; latent heat / evaporation comparison pathway.&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#990000&quot;&gt;&lt;b&gt;Limitations:&lt;/b&gt;&lt;/font&gt; no direct H; open complement is not sensible heat." vertex="1">
          <mxGeometry height="199" width="288" x="1345" y="620" as="geometry" />
        </mxCell>
        <mxCell id="note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeWidth=1.5;fontFamily=Helvetica;shadow=0;fontSize=18;align=left;verticalAlign=top;spacing=12;fillColor=#f8f9fa;strokeColor=#b7b7b7;" value="&lt;b&gt;Core balance:&lt;/b&gt; Q* − B = H + LE + R&lt;sub&gt;E&lt;/sub&gt;; therefore &lt;b&gt;R&lt;sub&gt;E&lt;/sub&gt; = Q* − B − H − LE&lt;/b&gt;, with &lt;b&gt;A = Q* − B&lt;/b&gt; as available energy.&lt;br&gt;&lt;br&gt;&lt;b&gt;Q*&lt;/b&gt;: net radiation (W m&lt;sup&gt;−2&lt;/sup&gt;) &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;B&lt;/b&gt;: soil heat flux (W m&lt;sup&gt;−2&lt;/sup&gt;; positive into soil) &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;H&lt;/b&gt;: sensible heat flux (W m&lt;sup&gt;−2&lt;/sup&gt;) &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;LE&lt;/b&gt;: latent heat flux (W m&lt;sup&gt;−2&lt;/sup&gt;) &amp;nbsp;&amp;nbsp;&amp;nbsp; &lt;b&gt;R&lt;sub&gt;E&lt;/sub&gt;&lt;/b&gt;: residual / non-closed energy term&lt;div&gt;&lt;br/&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="1620" x="10" y="830" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
